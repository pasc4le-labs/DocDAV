    "mermaid": "^11.16.1",
    "remixicon": "^4.9.1",
    "sanitize-html": "^2.17.7",
    "xlsx": "^0.18.5",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@playwright/test": "^1.62.1",
    "@sveltejs/adapter-node": "^5.0.0",
    "@sveltejs/kit": "^2.0.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@types/node": "^26.2.0",
    "jszip": "^3.10.1",
    "svelte": "^5.0.0",
