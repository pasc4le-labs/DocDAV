{
  "name": "drive-docs",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite dev --host 127.0.0.1 --port 4323",
