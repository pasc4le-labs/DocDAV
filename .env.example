# ---- WebDAV content source ----
# WebDAV base URL: replace <host>/<base>/<docsRoot> with your own:
#   https://<host>/<base>/<docsRoot>
# Credentials = the WebDAV username and password for your drive:
WEBDAV_URL=http://127.0.0.1:8090/
WEBDAV_USER=demo
WEBDAV_PASS=secret

# In-memory cache TTL for remote fetches (ms). Lower = fresher, higher = cheaper.
WEBDAV_TTL_MS=30000

# ---- Access control (in content, not env) ----
# Per-product password  →  add `password: <secret>` to that product's docs.yaml
# Site/homepage password →  add `password: <secret>` to a site.yaml at the root

# ---- Navbar customization ----
# Brand text shown in the navbar (used directly, or as the logo alt attribute).
DOCS_BRAND=drive-docs
# Optional logo <img> src/URL. When set, it is shown instead of the brand text.
# Can be an https URL or a data: URI, e.g.
#   DOCS_LOGO=https://example.com/logo.png
#   DOCS_LOGO=data:image/svg+xml;utf8,%3Csvg ...
#DOCS_LOGO=
